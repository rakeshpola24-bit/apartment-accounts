rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.uid == '6ENKVSVSsfeOiGPhPxax0XQJ3jf1'; }
    function profile() { return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data; }
    function member(a) {
      return signedIn() && profile().active == true
        && a in profile().apartmentIds
        && request.auth.uid in get(/databases/$(database)/documents/apartments/$(a)).data.memberUids;
    }
    function attributedCreate() {
      return request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;
    }
    function attributedUpdate() {
      return request.resource.data.updatedBy == request.auth.uid
        && (!('createdBy' in resource.data) || request.resource.data.createdBy == resource.data.createdBy);
    }
    match /staff/{uid} {
      allow read: if admin() || (signedIn() && request.auth.uid == uid);
      allow create, update, delete: if admin();
    }
    match /apartments/{a} {
      allow read: if admin() || (signedIn() && profile().active == true
        && a in profile().apartmentIds && request.auth.uid in resource.data.memberUids);
      allow create, update, delete: if admin();
      match /flats/{d} {
        allow read: if admin() || member(a);
        allow create, delete: if admin();
        allow update: if admin() || (member(a)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['owner','phone','kind','updatedBy','updatedAt'])
          && attributedUpdate());
      }
      match /payments/{d} {
        function live() { return !('voided' in resource.data) || resource.data.voided != true; }
        function validNew() {
          return request.resource.data.amount is number && request.resource.data.amount > 0
            && !request.resource.data.keys().hasAny(['voided','voidedBy','voidedAt','voidedName']);
        }
        function undo() {
          return live() && request.resource.data.voided == true
            && request.resource.data.voidedBy == request.auth.uid
            && request.resource.data.voidedAt == request.time
            && request.resource.data.voidedName is string
            && request.resource.data.updatedBy == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
              ['voided','voidedBy','voidedAt','voidedName','updatedBy','updatedAt']);
        }
        function correction() {
          return live() && attributedUpdate() && validNew();
        }
        allow read: if admin() || member(a);
        allow create: if (admin() || (member(a) && attributedCreate())) && validNew();
        allow update: if (admin() || member(a)) && (undo() || correction());
        allow delete: if false;
      }
      match /expenses/{d} {
        allow read: if admin() || member(a);
        allow create: if admin() || (member(a) && attributedCreate()
          && request.resource.data.amount is number && request.resource.data.amount > 0);
        allow update: if admin() || (member(a) && attributedUpdate()
          && request.resource.data.amount is number && request.resource.data.amount > 0);
        allow delete: if admin();
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
