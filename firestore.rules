rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function mail() {
      return request.auth.token.email.lower();
    }
    function aptData(a) {
      return get(/databases/$(database)/documents/apartments/$(a)).data;
    }
    function isMember(a) {
      return verified() && mail() in aptData(a).memberEmails;
    }
    match /apartments/{a} {
      allow read: if verified() && mail() in resource.data.memberEmails;
      allow create: if verified()
        && mail() in get(/databases/$(database)/documents/config/creators).data.emails
        && mail() in request.resource.data.ownerEmails
        && mail() in request.resource.data.memberEmails;
      allow update: if verified()
        && mail() in resource.data.ownerEmails
        && mail() in request.resource.data.ownerEmails
        && mail() in request.resource.data.memberEmails;
      allow delete: if verified() && mail() in resource.data.ownerEmails;
      match /flats/{d} { allow read, write: if isMember(a); }
      match /payments/{d} { allow read, write: if isMember(a); }
      match /expenses/{d} { allow read, write: if isMember(a); }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
